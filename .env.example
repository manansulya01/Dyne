# Supabase Configuration
# Get these from your Supabase project dashboard: Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only: Service Role Key (NEVER expose to browser, NEVER commit)
# Get this from your Supabase project dashboard: Settings > API
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# REQUIRED in production: the public origin of the deployed app, e.g.
# https://dyne.vercel.app — used for auth redirect URLs (password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Local development with Supabase CLI
# If using `supabase start` for local development, uncomment and use local values:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key