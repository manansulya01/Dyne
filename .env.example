# Dyne environment configuration. Copy to .env.local; never commit secrets.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Server-only; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Transitional MongoDB settings. Retain until every feature is migrated and verified.
MONGODB_URI=mongodb://127.0.0.1:27017/dyne_dev
MONGODB_DB=dyne_dev
AUTH_SECRET=change-me-to-a-long-random-secret-min-32-chars
NEXT_PUBLIC_SITE_URL=http://localhost:3000

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-local
# Optional Cloudflare R2:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=https://pub-xxx.r2.dev
# R2_BUCKET_PREFIX=

# Optional one-time admin bootstrap:
# ADMIN_BOOTSTRAP_SECRET=
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_DISPLAY_NAME=

# Optional moderation provider:
# CONTENT_MODERATION_API_URL=
# CONTENT_MODERATION_API_KEY=
# CONTENT_MODERATION_MODEL=
# CONTENT_MODERATION_PROVIDER=
# CONTENT_MODERATION_TIMEOUT_MS=
# CONTENT_MODERATION_SUPPORTS_MEDIA=false
