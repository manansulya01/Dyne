# Dyne — MongoDB-backed configuration
# Copy to .env.local for local development (NEVER commit .env.local).

# LOCAL DEVELOPMENT ONLY: use the isolated dyne_dev database.
# Start the local MongoDB server with: npm run db:dev
MONGODB_URI=mongodb://127.0.0.1:27017/dyne_dev
MONGODB_DB=dyne_dev

# Required for production; use a unique random secret (at least 32 characters).
# Generate with: openssl rand -base64 48
# Do not use this example value in a real deployment.
AUTH_SECRET=change-me-to-a-long-random-secret-min-32-chars

# Public origin of the app, e.g. https://dyne.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Storage driver: "local" for development/tests, "r2" for production.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-local

# Cloudflare R2 (production only, when STORAGE_DRIVER=r2; never commit values):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=https://pub-xxx.r2.dev
# R2_BUCKET_PREFIX=

# One-time bootstrap secret for promoting an existing account to super_admin.
# Set only while bootstrapping, then unset. Never commit the real value.
# ADMIN_BOOTSTRAP_SECRET=

# Initial administrator provisioning for a fresh install.
# Set these only for the one-time bootstrap command, then unset the password.
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_DISPLAY_NAME=
# Optional teacher bootstrap; set values as deployment secrets, not in Git.
# TEACHER_BOOTSTRAP_USERNAME=staff0
# TEACHER_BOOTSTRAP_EMAIL=staff0@your-school.example
# TEACHER_BOOTSTRAP_PASSWORD=use-a-unique-password
# TEACHER_BOOTSTRAP_DISPLAY_NAME=School Staff

# Optional AI-assisted moderation. Deterministic rules and manual review remain
# active regardless of whether an external classifier is configured.
# CONTENT_MODERATION_API_URL=
# CONTENT_MODERATION_API_KEY=
# CONTENT_MODERATION_MODEL=
# CONTENT_MODERATION_PROVIDER=
# CONTENT_MODERATION_TIMEOUT_MS=
# Set true only if the provider genuinely inspects image/video bytes.
# CONTENT_MODERATION_SUPPORTS_MEDIA=false
