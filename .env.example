# Dyne — MongoDB-backed configuration
# Copy to .env.local for local development (NEVER commit .env.local).

# REQUIRED: MongoDB connection string (Atlas in production).
MONGODB_URI=mongodb://127.0.0.1:27017/dyne

# Database name (default: "dyne").
MONGODB_DB=dyne

# REQUIRED in production: secret used for session handling (min 32 chars).
# Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-secret-min-32-chars

# Public origin of the app, e.g. https://dyne.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Storage driver: "local" (development/tests, no credentials) or "r2" (production).
STORAGE_DRIVER=local
# Directory for the local driver (defaults to ./storage-local).
STORAGE_LOCAL_DIR=./storage-local

# Cloudflare R2 (production only, when STORAGE_DRIVER=r2; never commit):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=https://pub-xxx.r2.dev
# R2_BUCKET_PREFIX=
