# Dyne environment configuration. Copy to .env.local; never commit secrets.

# MongoDB is the source of truth for authentication and application data.
MONGODB_URI=mongodb://127.0.0.1:27017/dyne_dev
MONGODB_DB=dyne_dev
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development uses local files. Production defaults to MongoDB GridFS.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-local
# Optional production override: STORAGE_DRIVER=mongodb-gridfs
# Optional alternative object store: STORAGE_DRIVER=r2 plus R2 credentials.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=
# R2_BUCKET_PREFIX=

# Optional one-time admin bootstrap:
# ADMIN_BOOTSTRAP_SECRET=
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_DISPLAY_NAME=

# Optional moderation provider:
# CONTENT_MODERATION_API_URL=
# CONTENT_MODERATION_API_KEY=
# CONTENT_MODERATION_MODEL=
# CONTENT_MODERATION_PROVIDER=
# CONTENT_MODERATION_TIMEOUT_MS=
# CONTENT_MODERATION_SUPPORTS_MEDIA=false
